# Бот: @smm_viktoryia_bot (токен из @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# ID чата получателя заявок (не username бота). Получить: npm run telegram:chat-id
TELEGRAM_CHAT_ID=your_chat_id
PORT=3001

# На Vercel эти переменные задаются в Dashboard → Project → Settings → Environment Variables
# (локальный .env на Vercel не используется)
